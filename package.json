{
  "name": "dsh-prompt-chain",
  "version": "1.1.0",
  "type": "module",
  "description": "⚡️DSH 输入框一键增强💪提示词(prompt)——嫌短就继续生成🔜，不满意就重新生成🔄；自动存档历史记录🕐，支持回退 ↩️；结果同步回输入框，差异逐行对比；🗺️显示界面🎨 提示词🪄按钮图标📍按键位置自己定制",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "prompt",
    "prompt-engineering",
    "rewrite",
    "continue"
  ],
  "author": "Nihao7-L",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/Nihao7-L/dsh-prompt-chain#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nihao7-L/dsh-prompt-chain.git"
  },
  "bugs": {
    "url": "https://github.com/Nihao7-L/dsh-prompt-chain/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.2-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.2 <0.1.2-rc.1 || >=0.1.2-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.3.0 || >=0.2.1-rc.1 <0.3.0"
  }
}
